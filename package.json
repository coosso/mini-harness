{
  "name": "code-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:web": "pnpm --filter @code-harness/web dev",
    "dev:tui": "pnpm --filter @code-harness/tui dev",
    "build": "pnpm --parallel -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "clean": "pnpm -r exec rimraf dist .vite coverage && rimraf node_modules",
    "ci": "pnpm install --frozen-lockfile && pnpm lint && pnpm format:check && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@11.21.0"
}
